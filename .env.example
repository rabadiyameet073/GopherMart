# Server Configuration
PORT=8080

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gophermart?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Authentication
JWT_SECRET=super-secret-gophermart-jwt-key-2026
JWT_EXPIRY_HOURS=24

# Token-Bucket Rate Limiter
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Asynchronous Worker Pool
WORKER_POOL_SIZE=5
WORKER_QUEUE_SIZE=100
WORKER_MAX_RETRIES=3
